<%# שדה טופס עם תווית ואייקון.
    פרמטרים: id, label, type, icon, placeholder, autocomplete,
    ואופציונלית: value, minlength, help (טקסט עזר מתחת לשדה) %>
<div class="field">
  <label class="field-label" for="<%= id %>"><%= label %></label>
  <div class="input-wrap">
    <input type="<%= type %>" id="<%= id %>" name="<%= id %>"
           placeholder="<%= placeholder %>" autocomplete="<%= autocomplete %>"
           value="<%= locals.value || '' %>"
           <% if (locals.minlength) { %>minlength="<%= minlength %>"<% } %>
           <% if (locals.help) { %>aria-describedby="<%= id %>-help"<% } %>
           required>
    <%- include('icon', { name: icon }) %>
  </div>
  <% if (locals.help) { %>
  <span class="field-help" id="<%= id %>-help"><%= help %></span>
  <% } %>
</div>
