<section class="comments-section" id="commentsSection" data-article-id="<%= article.id %>">
  <!-- כותרת תגובות -->
  <div class="comments-header">
    <h2 class="comments-title">
      תגובות קוראים · <span class="comments-count" id="commentsCount"><%= comments.length %></span>
    </h2>
    <button type="button" class="btn-write-comment" id="openCommentFormBtn">
      <svg class="btn-write-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        <line x1="12" y1="8" x2="12" y2="14"></line>
        <line x1="9" y1="11" x2="15" y2="11"></line>
      </svg>
      <span>כתיבת תגובה</span>
    </button>
  </div>

  <!-- טופס כתיבת תגובה (עיצוב Figma) -->
  <form class="comment-form-box" id="commentForm">
    <div class="comment-form-header">
      <% if (locals.user) { %>
        <div class="comment-user-badge">
          <span>מגיב/ה בתור:</span>
          <strong><%= user.name %></strong>
        </div>
      <% } else { %>
        <div class="comment-author-field">
          <input 
            type="text" 
            name="authorName" 
            id="commentAuthorName" 
            class="comment-input-name" 
            placeholder="שם (למשל: אורי כהן)" 
            maxlength="60" 
            required 
          />
        </div>
      <% } %>
    </div>

    <div class="comment-textarea-wrap">
      <textarea 
        name="content" 
        id="commentContent" 
        class="comment-textarea" 
        placeholder="מה דעתכם על הכתבה?" 
        rows="3" 
        maxlength="1000" 
        required
      ></textarea>
    </div>

    <div class="comment-form-footer">
      <button type="submit" class="btn-submit-comment" id="submitCommentBtn">
        <span>פרסום תגובה</span>
      </button>
    </div>

    <div class="comment-error-alert" id="commentFormError" style="display: none;" role="alert"></div>
  </form>

  <!-- רשימת התגובות -->
  <div class="comments-list" id="commentsList">
    <% if (comments && comments.length > 0) { %>
      <% comments.forEach(c => { %>
        <article class="comment-item" id="comment-<%= c.id %>" data-comment-id="<%= c.id %>">
          <div class="comment-avatar" aria-hidden="true">
            <span class="avatar-initials"><%= c.initials %></span>
          </div>
          <div class="comment-body">
            <header class="comment-meta">
              <span class="comment-author"><%= c.authorName %></span>
              <time class="comment-time" datetime="<%= c.createdAtIso %>"><%= c.relativeTime %></time>
            </header>
            <p class="comment-text"><%= c.content %></p>
            <footer class="comment-actions">
              <button type="button" class="btn-comment-action btn-reply" data-author="<%= c.authorName %>">השב</button>
              <button type="button" class="btn-comment-action btn-report">דיווח</button>
            </footer>
          </div>
        </article>
      <% }) %>
    <% } else { %>
      <p class="no-comments-msg" id="noCommentsMsg">אין עדיין תגובות לכתבה זו. היו הראשונים להגיב!</p>
    <% } %>
  </div>
</section>

