<%# תחילת כל דף: <head>, פתיחת <body> ועטיפה (container) שמקבלת את הקלאס של הדף.
    פרמטרים: title — כותרת הדף, styles — רשימת קבצי CSS נוספים (בלי סיומת), container — קלאס העטיפה. נסגר ב-footer %>
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title ? title + ' | ' : '' %>The Daily Web</title>
  <link rel="stylesheet" href="/css/style.css">
  <% (locals.styles || []).forEach(style => { %>
  <link rel="stylesheet" href="/css/<%= style %>.css">
  <% }) %>
</head>
<body>
<div class="<%= container %>">
