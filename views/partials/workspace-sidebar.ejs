<%# תפריט הצד של אזורי העבודה. מוסיפים כאן קישור כשנבנה הדף שלו.
    הקישורים נבחרים לפי התפקיד של המשתמש המחובר (res.locals.user).
    פרמטרים: active — המפתח (key) של הקישור הפעיל %>
<%
  const linksByRole = {
    writer: [
      { key: 'articles', label: 'הכתבות שלי', href: '/writer', icon: 'newspaper' },
    ],
    editor: [
      { key: 'queue', label: 'תור אישורים', href: '/editor', icon: 'list-checks' },
      { key: 'analytics', label: 'ניתוח השפעה', href: '/editor/analytics', icon: 'chart' },
    ],
  };
  const links = linksByRole[user.role] || [];
%>
<aside class="workspace-sidebar">
  <nav aria-label="תפריט אזור עבודה" class="workspace-nav">
    <p class="workspace-nav-title">מרחב עבודה</p>
    <% links.forEach(link => { %>
    <a href="<%= link.href %>" class="workspace-link"<%- link.key === active ? ' aria-current="page"' : '' %>>
      <%- include('icon', { name: link.icon }) %>
      <%= link.label %>
    </a>
    <% }) %>
  </nav>
</aside>
