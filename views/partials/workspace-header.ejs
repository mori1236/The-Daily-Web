<%# כותרת אזורי העבודה (כתב / עורך): לוגו, שם האזור והמשתמש המחובר.
    פרמטרים: area — שם האזור (למשל "אזור כתב"). המשתמש מגיע מ-res.locals.user %>
<%
  const roleLabels = { writer: 'כתב/ת', editor: 'עורך/ת' };
  const initials = user.name.trim().split(/\s+/).slice(0, 2).map(word => word[0]).join('');
%>
<header class="workspace-header">
  <div class="workspace-context">
    <a href="/" class="workspace-brand">
      <span class="workspace-brand-name">The Daily Web</span>
      <span class="workspace-brand-edition">
        <span class="live-dot"></span>
        החדשות החמות ברשת
      </span>
    </a>
    <span class="workspace-area"><%= area %></span>
  </div>

  <div class="workspace-account">
    <div class="workspace-user">
      <span class="workspace-user-details">
        <span class="workspace-user-name"><%= user.name %></span>
        <span class="workspace-user-role"><%= roleLabels[user.role] %></span>
      </span>
      <span class="workspace-avatar" aria-hidden="true"><%= initials %></span>
    </div>
    <form action="/logout" method="POST" class="workspace-logout">
      <button type="submit" class="workspace-logout-button" aria-label="התנתקות" title="התנתקות">
        <%- include('icon', { name: 'log-out' }) %>
      </button>
    </form>
  </div>
</header>
