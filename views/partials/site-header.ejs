<%# כותרת האתר העליונה — לוגו, ניווט וקישורים %>
<header class="site-header">
  <logo>
    <p class="text-logo">The Daily Web</p>
    <div style="display: flex; align-items: center; gap: 6px;">
      <span class="live-dot"></span>
      <p class="sub-text-logo">החדשות החמות ברשת</p>
    </div>
  </logo>
  <nav>
    <a href="/" data-text="ראשי">ראשי</a>
    <a href="/" data-text="פוליטי">פוליטי</a>
    <a href="/" data-text="כלכלה">כלכלה</a>
    <a href="/" data-text="טכנולוגיה">טכנולוגיה</a>
    <a href="/" data-text="תרבות">תרבות</a>
    <a href="/" data-text="ספורט">ספורט</a>
  </nav>

  <div class="site-header-actions">
    <a href="/">חיפוש</a>
    <% if (locals.user) { %>
    <a href="<%= user.role === 'editor' ? '/editor' : '/writer' %>"><%= user.name %></a>
    <form action="/logout" method="POST" class="site-header-logout">
      <button type="submit">התנתקות</button>
    </form>
    <% } else { %>
    <a href="/login">התחברות לכתבים/עורכים</a>
    <% } %>
  </div>
</header>
