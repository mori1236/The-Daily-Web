<%- include('partials/header', { title: 'שגיאה', styles: ['forms', 'auth'], container: 'auth-page' }) %>

  <%- include('partials/auth-story') %>

  <main class="auth-main">
    <a href="/" class="auth-back">
      חזרה לאתר החדשות
      <%- include('partials/icon', { name: 'arrow-left' }) %>
    </a>

    <section class="auth-card">
      <div class="auth-card-header">
        <h1><%= locals.message || 'אירעה שגיאה' %></h1>
        <p><%= locals.details || 'משהו השתבש מצדנו. נסו שוב בעוד כמה רגעים.' %></p>
      </div>

      <a href="<%= locals.retryUrl || '/' %>" class="btn btn-primary btn-block"><%= locals.retryLabel || (locals.retryUrl ? 'נסו שוב' : 'חזרה לדף הבית') %></a>
    </section>
  </main>

<%- include('partials/footer') %>
