<%- include('partials/header', { title: '', container: 'home-page', styles: ['index'] }) %>
  <%- include('partials/site-header') %>

  <!-- פס מבזקי חדשות רצים / כותרת חמה מתחת לתפריט -->
  <%# <div class="breaking-news-bar"> %>
    <%# <div class="breaking-container"> %>
      <%# <div class="breaking-headline"> %>
        <%# <span class="breaking-tag">חדשות חמות</span> %>
        <%# <span class="breaking-text">הקבינט יתכנס בצהריים לדיון מיוחד במתווה הסיוע לצפון</span> %>
