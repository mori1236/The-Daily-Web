  <div class="main-container">
    <!-- אזור עליון: כתבה ראשית ו-ווידג'ט מזג אוויר -->
    <section class="upper-section">
      <!-- כרטיס הסיפור המרכזי (בימין בדפי RTL) -->
      <% if (heroArticle) { %>
        <article class="hero-article-card" id="heroArticleCard" data-article-id="<%= heroArticle.id %>">
          <div class="hero-content">
            <div class="hero-top-badge">
              <span class="hero-badge" id="heroBadge">הסיפור המרכזי</span>
            </div>
            
            <h1 class="hero-title" id="heroTitle"><%= heroArticle.title %></h1>
            
            <p class="hero-summary" id="heroSummary"><%= heroArticle.summary %></p>
            
            <div class="hero-bottom-row">
              <div class="hero-meta">
                <span id="heroAuthor">מאת <%= heroArticle.writer %></span>
                <span class="meta-dot">·</span>
                <span id="heroTime"><%= heroArticle.publishedAtFormatted %></span>
                <span class="meta-dot">·</span>
                <span id="heroReadingTime"><%= heroArticle.readingTime %></span>
              </div>
              <a href="<%= heroArticle.url %>" class="hero-read-btn" id="heroReadBtn">
                <span>לכתבה המלאה</span>
                <span class="btn-arrow" aria-hidden="true">←</span>
              </a>
            </div>
          </div>
          <div class="hero-image-wrap">
            <img 
              id="heroImg"
              src="<%= heroArticle.imageUrl %>" 
              alt="<%= heroArticle.title %>"
              onerror="this.onerror=null; this.src='/img/login-newsroom.jpg';"
            />
          </div>
        </article>
      <% } %>

      <!-- ווידג'ט מזג אוויר (בשמאל בדפי RTL) -->

    </section>
    
    <!-- סרגל סינון קטגוריות, חיפוש ומיון -->
    <div class="filter-bar">
      <!-- קטגוריות כצ'יפים -->
      <!-- <div class="categories-group" role="tablist" aria-label="סינון לפי קטגוריה">
        <button type="button" class="category-chip <%= (!locals.currentCategory || currentCategory === 'all') ? 'active' : '' %>" data-category="all">
          <span class="label">הכל</span>
        </button>
        <button type="button" class="category-chip <%= (locals.currentCategory === 'politics') ? 'active' : '' %>" data-category="politics">
          <span class="label">פוליטי</span>
        </button>
        <button type="button" class="category-chip <%= (locals.currentCategory === 'economy') ? 'active' : '' %>" data-category="economy">
          <span class="label">כלכלה</span>
        </button>
        <button type="button" class="category-chip <%= (locals.currentCategory === 'tech') ? 'active' : '' %>" data-category="tech">
          <span class="label">טכנולוגיה</span>
        </button>
        <button type="button" class="category-chip <%= (locals.currentCategory === 'culture') ? 'active' : '' %>" data-category="culture">
          <span class="label">תרבות</span>
        </button>
        <button type="button" class="category-chip <%= (locals.currentCategory === 'sports') ? 'active' : '' %>" data-category="sports">
          <span class="label">ספורט</span>
        </button>
      </div> -->
      
        <!-- תיבת חיפוש -->
        <div class="search-box">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="חיפוש כתבות, נושאים וכתבים" 
            aria-label="חיפוש כתבות"
          />
          <div class="search-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
        </div>
        
        <!-- תיבת סינון לפי סטטוס צפייה (מימין ל-sort-box) -->
        <div class="sort-box read-filter-box">
          <select id="readStatusSelect" aria-label="סינון לפי סטטוס צפייה">
            <option value="all" selected>כל הסטטוסים</option>
            <option value="unread">טרם נצפה</option>
            <option value="read">נצפה</option>
          </select>
          <div class="sort-icon" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#555B57" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
        </div>

        <!-- תיבת מיון -->
        <div class="sort-box">
          <select id="sortSelect" aria-label="מיון כתבות">
            <option value="newest" <%= (locals.currentSort !== 'popularity') ? 'selected' : '' %>>החדשות ביותר</option>
            <option value="popularity" <%= (locals.currentSort === 'popularity') ? 'selected' : '' %>>פופולריות</option>
          </select>
          <div class="sort-icon" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
              <path d="M4 6L7.5 2.5L11 6" stroke="#555B57" stroke-width="1.3" stroke-linecap="round"/>
              <path d="M11 9L7.5 12.5L4 9" stroke="#555B57" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
          </div>
        </div>
      </div>

    <!-- פיד הכתבות הראשי -->
    <main class="feed-section" id="feedMain" data-current-category="<%= locals.currentCategory || 'all' %>">
      <div id="articlesGrid" class="articles-grid">
        <% if (articles && articles.length > 0) { %>
          <% articles.forEach(article => { %>
            <%- include('partials/article-card', { article }) %>
          <% }) %>
        <% } %>
      </div>

      <!-- הודעת תוצאות ריקות -->
      <div id="emptyState" class="empty-state" style="<%= (articles && articles.length > 0) ? 'display: none;' : '' %>">
        <p>לא נמצאו כתבות התואמות לחיפוש או לקטגוריה שנבחרה.</p>
      </div>

      <!-- אינדיקטור טעינה וגלילה אינסופית -->
      <div class="feed-pagination-wrap">
        <div id="feedLoader" class="feed-loader" style="display: none;">
          <div class="spinner"></div>
          <span>טוען 20 כתבות נוספות...</span>
        </div>

        <button type="button" id="loadMoreBtn" class="load-more-btn">
          הצגת כתבות נוספות
        </button>

        <div id="allLoadedNotice" class="all-loaded-notice" style="display: none;">
          <span>הגעת לסוף הפיד — כל הכתבות מוצגות</span>
        </div>

        <!-- אלמנט עוגן בלתי נראה עבור IntersectionObserver -->
        <div id="scrollSentinel" class="scroll-sentinel" aria-hidden="true"></div>
      </div>
    </main>
  </div>

  <!-- סקריפט הפיד לניהול סינון, חיפוש וגלילה אינסופית ב-AJAX -->
  <script src="/js/feed.js"></script>
</body>
</html>
