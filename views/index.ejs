<%- include('partials/head', { title: '' }) %>
<body>

  <%- include('partials/site-header') %>

  <div class="main-container">
    <!-- אזור הסינון והחיפוש (צד לקוח שיעבוד עם AJAX בהמשך) -->
    <aside class="filters-sidebar">
      <h3>סינון וחיפוש</h3>
      <input type="text" id="searchInput" placeholder="חיפוש לפי כותרת...">
      
      <select id="categorySelect">
        <option value="">כל הקטגוריות</option>
        <option value="tech">טכנולוגיה</option>
        <option value="sport">ספורט</option>
        <option value="news">חדשות כלליות</option>
      </select>
    </aside>

    <!-- פיד הכתבות הראשי -->
    <main class="feed-section">
      <h2>כתבות אחרונות</h2>
      
      <div id="articlesContainer">
        <!-- לולאה שרצה על מערך הכתבות שהגיע מהשרת -->
        <% if (articles && articles.length > 0) { %>
          <% articles.forEach(article => { %>
            <article class="article-card">
              <% if (article.published && article.published.imageUrl) { %>
                <img src="<%= article.published.imageUrl %>" alt="<%= article.published.title %>">
              <% } %>
              <div class="article-content">
                <span class="category"><%= article.published.category %></span>
                <h3>
                  <a href="/articles/<%= article._id %>"><%= article.published.title %></a>
                </h3>
                <p class="summary"><%= article.published.summary %></p>
                <div class="meta">
                  <span>כתב: <%= article.writer ? article.writer.name : 'מערכת' %></span> |
                  <span>פורסם ב: <%= new Date(article.published.publishedAt).toLocaleDateString('he-IL') %></span>
                </div>
              </div>
            </article>
          <% }) %>
        <% } else { %>
            <p>אין כתבות להצגה כרגע.</p>
        <% } %>
      </div>

      <!-- אלמנט עוגן עבור גלילה אינסופית (Infinite Scroll) -->
      <div id="loadingIndicator" style="display: none;">טוען כתבות נוספות...</div>
    </main>

    <!-- סיידבר הכולל למשל את ווידג'ט מזג האוויר -->
    <aside class="right-sidebar">
      <div id="weatherWidget">
        <h3>מזג אוויר</h3>
        <p>טוען נתוני מזג אוויר...</p>
      </div>
    </aside>
  </div>

  <!-- סקריפט צד לקוח לטיפול בחיפוש, סינון וגלילה אינסופית ב-AJAX -->
  <script src="/js/feed.js"></script>
</body>
</html>
