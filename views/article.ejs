<%- include('partials/header', { title: article.title, styles: ['index', 'article'], container: 'container', seo }) %>

  <%- include('partials/site-header') %>

  <div class="article-page-container">
    <nav class="article-breadcrumb" aria-label="ניווט">
      <a href="/" class="back-link">
        <span class="arrow" aria-hidden="true">→</span>
        <span>חזרה לכל הכתבות</span>
      </a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-category"><%= article.categoryLabel %></span>
    </nav>

    <main>
    <article class="article-single">
      <header class="article-header">
        <div class="article-tag-row">
          <span class="article-tag category-<%= article.category %>"><%= article.categoryLabel %></span>
          <span class="article-read-time"><%= article.readingTime %></span>
        </div>

        <h1 class="article-page-title"><%= article.title %></h1>

        <% if (article.summary) { %>
          <p class="article-page-lead"><%= article.summary %></p>
        <% } %>

        <div class="article-byline">
          <div class="author-info">
            <span class="author-avatar" aria-hidden="true">✍</span>
            <div class="author-details">
              <span class="author-name">מאת <%= article.writer %></span>
              <% const formatDate = value => new Intl.DateTimeFormat('he-IL', { timeZone: 'Asia/Jerusalem', dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value)); %>
              <span class="publish-date">פורסם <time datetime="<%= seo.published %>"><%= formatDate(article.publishedAt) %></time><% if (seo.modified !== seo.published) { %> · עודכן <time datetime="<%= seo.modified %>"><%= formatDate(article.updatedAt) %></time><% } %></span>
            </div>
          </div>

          <div class="article-stats">
            <a href="#commentsSection" class="comments-badge" title="מעבר לתגובות">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
              <span><span id="bylineCommentsCount"><%= comments.length %></span> תגובות</span>
            </a>
            <span class="views-badge" title="צפיות בכתבה">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <span><%= article.viewCount %> צפיות</span>
            </span>
          </div>
        </div>
      </header>

        <figure class="article-featured-media">
          <img 
            src="<%= article.imageUrl || '/img/default-article.jpg' %>"
            alt="<%= article.title %>"
            data-article-image
          />
        </figure>

      <section class="article-body">
        <% 
          const contentToRender = fullContent || article.summary || '';
        %>
        
        <% if (contentToRender.trim().length > 0) { %>
          <%- contentToRender %>
        <% } else { %>
          <p><%= article.summary %></p>
        <% } %>
      </section>

      <!-- אזור תגובות קוראים (Figma) -->
      <%- include('partials/comments', { comments, article }) %>

      <!-- כפתור שיתוף / חזרה -->
      <footer class="article-page-footer">
        <a href="/" class="back-home-button">
          <span>חזרה לפיד החדשות</span>
          <span aria-hidden="true">←</span>
        </a>
      </footer>

      <!-- עוד כתבות מומלצות -->
      <% if (locals.moreArticles && moreArticles.length > 0) { %>
        <section class="related-articles-section">
          <h2 class="related-heading">כתבות נוספות שעשויות לעניין אותך</h2>
          <div class="articles-grid">
            <% moreArticles.forEach(item => { %>
              <%- include('partials/article-card', { article: item }) %>
            <% }) %>
          </div>
        </section>
      <% } %>
    </article>
    </main>
  </div>

  <script src="/js/article.js"></script>
<%- include('partials/footer') %>
