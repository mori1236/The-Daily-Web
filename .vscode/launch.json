{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Debug: start",
      "port": 9229,
      "restart": false,
      "preLaunchTask": "npm: start",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Debug: dev (nodemon)",
      "port": 9229,
      "restart": true,
      "preLaunchTask": "npm: dev",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/public"
    }
  ],
  "compounds": [
    {
      "name": "nodemon + Chrome",
      "configurations": ["Debug: dev (nodemon)", "Launch Chrome"]
    }
  ]
}
